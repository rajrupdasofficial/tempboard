# All secrets are read from the environment in ONE place only: lib/env.js
# Copy this file to .env.local for development. On Vercel, add the same keys under Project -> Settings -> Environment Variables.
# Never prefix any of these with NEXT_PUBLIC_ and never commit the real file.

# Vercel Blob: Storage -> create Blob store -> connect to project (Vercel injects it automatically)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis: console.upstash.com -> your database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Master secret used to hash OTP keys and encrypt stored data (min 32 chars).
# Generate with:  openssl rand -base64 48
# Rotating it invalidates every active OTP (fine, they are temporary).
APP_SECRET=

# Shared secret for the cron cleanup job. Vercel sends it as "Authorization: Bearer <value>".
# Generate with:  openssl rand -hex 32
CRON_SECRET=
